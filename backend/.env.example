# Monaco Backend Environment Configuration
# See: https://github.com/oni-lore/Monaco

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monaco

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string

# Server
HOST=0.0.0.0
PORT=3000

# Cloudflare R2 (Media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREGO_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Feature flags
ENABLE_PHONE_VERIFICATION=false
ENABLE_CLOUDINER=false